# ============================================================
# Banco de dados
# ------------------------------------------------------------
# Dev (default): SQLite (arquivo local em prisma/dev.db).
DATABASE_URL="file:./dev.db"
#
# PRODUÇÃO (PostgreSQL):
# 1. Em prisma/schema.prisma trocar:  provider = "postgresql"
# 2. Rodar:  npx prisma migrate deploy   (não use db:seed!)
# 3. URL no formato:
#    DATABASE_URL="postgresql://user:pass@host:5432/dbname?schema=public&sslmode=require"
# ============================================================

# ============================================================
# Autenticação do painel admin
# ------------------------------------------------------------
# DEV: qualquer string ≥ 16 chars serve.
# PROD: obrigatório 32+ caracteres aleatórios. O servidor recusa
# subir se for menor ou se for um dos valores marcados como padrão
# em src/lib/auth.ts (WEAK_DEFAULTS).
#
# **NUNCA commite um secret real neste arquivo.**
#
# Gerar em PowerShell (Windows):
#   [Convert]::ToBase64String((1..48 | %% { Get-Random -Maximum 256 }))
# Gerar em bash/Linux:
#   openssl rand -hex 48
# ou:
#   openssl rand -base64 48
AUTH_SECRET="troque-em-producao"

# URL pública do site (usada em metadata, OG, sitemap, JSON-LD)
# Em produção: use o domínio HTTPS final (sem barra no fim)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# ============================================================

# ============================================================
# Admin inicial (apenas para o seed da PRIMEIRA execução)
# ------------------------------------------------------------
# Essas variáveis são consumidas UMA ÚNICA VEZ, no `npm run db:seed`
# ou `npm run admin:create-comercial`, para gravar o hash bcrypt no
# banco. Depois disso o login usa apenas o hash do banco.
#
# EM PRODUÇÃO, após criar o usuário na primeira execução:
#   1. Logue em /admin/login com essa senha
#   2. Abra /admin/conta e troque por senha forte
#   3. REMOVA ADMIN_PASSWORD do .env.production
#   4. Reinicie o processo Node (PM2 restart)
#
# NUNCA mantenha admin123 em produção. O dashboard mostra banner
# amarelo enquanto a senha padrão estiver ativa.
ADMIN_EMAIL="admin@traveltech.com.br"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Administrador"
# ============================================================

# ============================================================
# Usuário comercial (script prisma/scripts/create-comercial-user.ts)
# ------------------------------------------------------------
# O script `npm run admin:create-comercial` cria ou atualiza o
# usuário `comercial@traveltech2.com` de forma idempotente. A senha
# é LIDA SÓ desta variável — nunca fica hardcoded no script.
#
# Uso ad-hoc (sem gravar em .env):
#   COMERCIAL_ADMIN_PASSWORD="senha-temporaria" npm run admin:create-comercial
#
# Se preferir deixar temporariamente aqui para criar o usuário e
# depois REMOVER a linha, funciona igual (o script chama loadEnvFile).
# Depois de criado, peça ao usuário para trocar a senha em /admin/conta
# no primeiro login e apague esta variável do ambiente.
COMERCIAL_ADMIN_PASSWORD=""
# ============================================================

# ============================================================
# Upload de imagens (logo, banners, produtos, categorias)
# ------------------------------------------------------------
# DEV: se vazio, salva em /public/uploads (não funciona em
# hospedagens serverless tipo Vercel — arquivos somem).
# PROD: OBRIGATÓRIO preencher as 3. Sem isso o admin retorna
# erro claro ao tentar fazer upload.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# ============================================================

# ============================================================
# Analytics (opcionais — deixar vazio desativa)
# ------------------------------------------------------------
# Google Analytics 4 — formato "G-XXXXXXXXXX"
NEXT_PUBLIC_GA_ID=""

# Meta (Facebook) Pixel — ID numérico do pixel (15-16 dígitos)
NEXT_PUBLIC_META_PIXEL_ID=""
# ============================================================
